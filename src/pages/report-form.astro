---
import ReportForm from "../components/ReportForm.jsx";
const category = Astro.url.searchParams.get("category") ?? "infraestructura";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Generar reporte · Malecón La Paz</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@3/base.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-950">
    <ReportForm category={category} client:only="react" />
  </body>
</html>
