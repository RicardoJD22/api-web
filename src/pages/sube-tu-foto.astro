---
// src/pages/sube-tu-foto.astro
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Comparte tu foto · Malecón de La Paz</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: #020617; font-family: system-ui, sans-serif; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse-ring {
      0%   { transform: scale(1);    opacity: 0.6; }
      100% { transform: scale(1.55); opacity: 0; }
    }
    @keyframes successPop {
      0%   { opacity: 0; transform: scale(0.8); }
      70%  { transform: scale(1.05); }
      100% { opacity: 1; transform: scale(1); }
    }

    .anim-fadeup             { animation: fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both; }
    .anim-delay-1            { animation-delay: 0.07s; }
    .anim-delay-2            { animation-delay: 0.14s; }
    .anim-delay-3            { animation-delay: 0.21s; }
    .anim-delay-4            { animation-delay: 0.28s; }

    /* Drop zone */
    .drop-zone               { transition: border-color 0.2s, background 0.2s; }
    .drop-zone.dragover      { border-color: #818cf8 !important; background: rgba(99,102,241,0.1); }

    /* Show / hide con display explícito */
    .d-none  { display: none !important; }
    .d-flex  { display: flex !important; }
    .d-block { display: block !important; }

    /* Botón enviar */
    .btn-submit:active { transform: scale(0.97); }

    /* Estado éxito */
    #successState .success-icon { animation: successPop 0.5s cubic-bezier(0.34,1.56,0.64,1) both 0.1s; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start px-4 py-10 pb-24">

  <!-- Fondo decorativo -->
  <div class="fixed inset-0 pointer-events-none -z-10">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full opacity-50"
         style="background:radial-gradient(circle,rgba(99,102,241,0.15) 0%,transparent 70%)"></div>
  </div>

  <!-- Header -->
  <div class="w-full max-w-md mb-8 anim-fadeup">
    <div class="flex items-center gap-3 mb-2">
      <div class="relative w-10 h-10 shrink-0">
        <div class="absolute inset-0 rounded-full bg-indigo-500/40"
             style="animation:pulse-ring 1.8s ease-out infinite"></div>
        <div class="relative w-10 h-10 rounded-full bg-indigo-600/30 border border-indigo-400/60
                    flex items-center justify-center text-xl">📸</div>
      </div>
      <div>
        <h1 class="text-2xl font-black text-white tracking-tight leading-none">Comparte tu postal</h1>
        <p class="text-indigo-300 text-xs font-bold tracking-widest uppercase mt-0.5">Malecón de La Paz</p>
      </div>
    </div>
    <p class="text-slate-400 text-sm leading-relaxed">
      Comparte tu mejor momento y forma parte de la galería ciudadana.
    </p>
  </div>

  <!-- ── FORMULARIO ────────────────────────────────────────────────────── -->
  <form id="uploadForm" class="w-full max-w-md flex flex-col gap-5" autocomplete="off" novalidate>

    <!-- Zona de foto: <label> nativo — más fiable en móvil -->
    <div class="anim-fadeup anim-delay-1">
      <p class="text-slate-300 text-sm font-bold mb-2 tracking-wide">
        Foto <span class="text-indigo-400">*</span>
      </p>

      <!-- Input oculto -->
      <input type="file" id="fileInput" accept="image/*" class="d-none" />

      <!-- Zona visible -->
      <div id="dropZone"
           class="drop-zone w-full rounded-3xl border-2 border-dashed border-slate-600
                  bg-slate-900/60 overflow-hidden relative cursor-pointer"
           style="min-height:14rem">

        <!-- Placeholder (visible por defecto) -->
        <label for="fileInput" id="placeholder"
               class="absolute inset-0 flex flex-col items-center justify-center gap-3
                      cursor-pointer select-none">
          <span class="text-5xl">🌊</span>
          <span class="text-slate-400 text-sm font-semibold">Toca para elegir una foto</span>
          <span class="text-slate-600 text-xs">JPG · PNG · WebP · máx 5 MB</span>
        </label>

        <!-- Preview (oculto por defecto) -->
        <img id="previewImg" src="" alt="Vista previa"
             class="d-none absolute inset-0 w-full h-full object-cover rounded-3xl" />

        <!-- Botón quitar foto (oculto por defecto) -->
        <button type="button" id="clearBtn"
                class="d-none absolute top-3 right-3 w-9 h-9 rounded-full
                       bg-slate-900/90 border border-slate-500 text-white
                       items-center justify-center text-base z-10 backdrop-blur">✕</button>
      </div>
    </div>

    <!-- Nombre -->
    <div class="anim-fadeup anim-delay-2">
      <label for="nombre" class="block text-slate-300 text-sm font-bold mb-2 tracking-wide">
        Tu nombre <span class="text-indigo-400">*</span>
      </label>
      <input type="text" id="nombre" name="nombre" placeholder="Ej. María González"
             class="w-full bg-slate-900/80 border border-slate-700 text-white
                    placeholder-slate-500 rounded-2xl px-5 py-4 text-base outline-none
                    focus:border-indigo-500 transition" />
    </div>

    <!-- Comentario -->
    <div class="anim-fadeup anim-delay-3">
      <label for="comentario" class="block text-slate-300 text-sm font-bold mb-2 tracking-wide">
        Comentario <span class="text-slate-500 font-normal">(opcional)</span>
      </label>
      <textarea id="comentario" name="comentario" rows="3"
                placeholder="¿Qué momento fue este?"
                class="w-full bg-slate-900/80 border border-slate-700 text-white
                       placeholder-slate-500 rounded-2xl px-5 py-4 text-base outline-none
                       focus:border-indigo-500 transition resize-none"></textarea>
    </div>

    <!-- Privacidad -->
    <div class="anim-fadeup anim-delay-4 flex items-start gap-3 bg-slate-900/60 border border-slate-700
                rounded-2xl px-4 py-4 cursor-pointer" id="privacidadBox">
      <input type="checkbox" id="privacidad" name="privacidad"
             class="mt-0.5 w-6 h-6 shrink-0 accent-indigo-500 cursor-pointer" />
      <label for="privacidad" class="text-slate-400 text-sm leading-relaxed cursor-pointer">
        Acepto que mi foto y nombre puedan publicarse en la galería del Malecón de La Paz
        con fines culturales y turísticos.
      </label>
    </div>

    <!-- Nota demo -->
    <p class="text-slate-600 text-xs text-center -mt-2">
      ℹ️ Las fotos son revisadas antes de aparecer en la galería
    </p>

    <!-- Enviar — deshabilitado hasta aceptar términos -->
    <button type="submit" id="submitBtn" disabled
            class="btn-submit w-full text-white font-black text-lg py-5
                   rounded-3xl flex items-center justify-center gap-3
                   anim-fadeup anim-delay-4 transition-all duration-300
                   bg-slate-700 opacity-50 cursor-not-allowed">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
      </svg>
      Enviar foto
    </button>
  </form>

  <!-- ── ÉXITO ──────────────────────────────────────────────────────────── -->
  <div id="successState"
       class="d-none w-full max-w-md flex-col items-center gap-6 text-center py-8">
    <div class="success-icon w-28 h-28 rounded-full bg-emerald-500/20 border-2
                border-emerald-400/60 flex items-center justify-center text-6xl">🎉</div>
    <div>
      <h2 class="text-2xl font-black text-white mb-2">¡Gracias por compartir!</h2>
      <p class="text-slate-400 text-base leading-relaxed max-w-xs mx-auto">
        Tu foto fue recibida. Pronto podrías verla en la galería del malecón.
      </p>
    </div>
    <button onclick="window.history.back()"
            class="bg-slate-800 border border-slate-600 text-white font-bold
                   py-4 px-8 rounded-2xl text-base active:scale-95 transition">
      ← Volver a la galería
    </button>
  </div>

  <script>
    const fileInput   = document.getElementById('fileInput');
    const dropZone    = document.getElementById('dropZone');
    const placeholder = document.getElementById('placeholder');
    const previewImg  = document.getElementById('previewImg');
    const clearBtn    = document.getElementById('clearBtn');
    const form        = document.getElementById('uploadForm');
    const successDiv  = document.getElementById('successState');

    // ── Vista previa ──────────────────────────────────────────────────────
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) loadPreview(file);
    });

    function loadPreview(file) {
      if (!file.type.startsWith('image/')) {
        alert('Por favor selecciona un archivo de imagen (JPG, PNG, WebP).');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert('La imagen no debe superar los 5 MB.');
        return;
      }
      const reader = new FileReader();
      reader.onload = (ev) => {
        previewImg.src = ev.target.result;
        previewImg.classList.remove('d-none');
        previewImg.classList.add('d-block');
        clearBtn.classList.remove('d-none');
        clearBtn.classList.add('d-flex');
        placeholder.classList.add('d-none');
        dropZone.style.borderStyle = 'solid';
        dropZone.style.borderColor = 'rgba(99,102,241,0.6)';
      };
      reader.readAsDataURL(file);
    }

    // ── Quitar foto ───────────────────────────────────────────────────────
    clearBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      fileInput.value = '';
      previewImg.src = '';
      previewImg.classList.add('d-none');
      previewImg.classList.remove('d-block');
      clearBtn.classList.add('d-none');
      clearBtn.classList.remove('d-flex');
      placeholder.classList.remove('d-none');
      dropZone.style.borderStyle = 'dashed';
      dropZone.style.borderColor = '';
    });

    // ── Drag & drop (escritorio) ──────────────────────────────────────────
    dropZone.addEventListener('dragover',  (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', ()  => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      const file = e.dataTransfer.files[0];
      if (file) { loadPreview(file); }
    });

    // ── Activar botón según checkbox ─────────────────────────────────────
    const submitBtn    = document.getElementById('submitBtn');
    const privacidad   = document.getElementById('privacidad');
    const privacidadBox = document.getElementById('privacidadBox');

    function updateBtn() {
      const ok = privacidad.checked;
      submitBtn.disabled = !ok;
      if (ok) {
        submitBtn.classList.remove('bg-slate-700', 'opacity-50', 'cursor-not-allowed');
        submitBtn.classList.add('bg-indigo-600', 'hover:bg-indigo-500', 'shadow-[0_0_30px_rgba(99,102,241,0.35)]');
        privacidadBox.classList.add('border-indigo-500/50', 'bg-indigo-950/30');
        privacidadBox.classList.remove('border-slate-700');
      } else {
        submitBtn.classList.add('bg-slate-700', 'opacity-50', 'cursor-not-allowed');
        submitBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-500', 'shadow-[0_0_30px_rgba(99,102,241,0.35)]');
        privacidadBox.classList.remove('border-indigo-500/50', 'bg-indigo-950/30');
        privacidadBox.classList.add('border-slate-700');
      }
    }

    privacidad.addEventListener('change', updateBtn);
    updateBtn(); // estado inicial

    // ── Enviar ────────────────────────────────────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!fileInput.files[0]) {
        alert('Selecciona una foto antes de enviar.');
        return;
      }
      const nombre = document.getElementById('nombre').value.trim();
      if (!nombre) {
        alert('Escribe tu nombre.');
        document.getElementById('nombre').focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';

      const fd = new FormData();
      fd.append('photo',      fileInput.files[0]);
      fd.append('nombre',     nombre);
      fd.append('comentario', document.getElementById('comentario').value.trim());

      try {
        const res  = await fetch('/api/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error al subir');
        form.classList.add('d-none');
        successDiv.classList.remove('d-none');
        successDiv.classList.add('d-flex');
      } catch (err) {
        alert('No se pudo subir la foto: ' + err.message);
        updateBtn();
      }
    });
  </script>
</body>
</html>
