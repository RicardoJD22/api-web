---
import Layout from '../layouts/Layout.astro';
import MaleconApp from '../components/MaleconApp.jsx';
---

<Layout title="Guía Interactiva del Malecón - La Paz BCS">
  <main class="w-full h-screen overflow-hidden m-0 p-0 fixed inset-0">
    {/* client:only — MapLibre GL requiere acceso a Window/WebGL, se monta solo en el cliente */}
    <MaleconApp client:only="react" />
  </main>
</Layout>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Comportamiento touch de kiosco */
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ── Reposicionar botones flotantes en la página del mapa ─────────────────
     En otras páginas van en bottom-8; aquí los subimos al área del mapa
     para que no tapen el directorio inferior.
  ───────────────────────────────────────────────────────────────────────── */
  .back-btn {
    bottom: auto !important;
    top: 1.5rem !important;
  }

  #a11y-toggle {
    bottom: auto !important;
    top: 1.5rem !important;
  }

  /* El panel de accesibilidad se abre hacia abajo cuando el botón está arriba */
  #a11y-panel {
    bottom: auto !important;
    top: 5.5rem !important;
    transform-origin: top right !important;
  }
</style>
