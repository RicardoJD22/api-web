---
import Layout from '../layouts/Layout.astro';
import MaleconApp from '../components/MaleconApp.jsx';
---

<Layout title="Guía Interactiva del Malecón - La Paz BCS">
  <main class="w-full h-screen overflow-hidden m-0 p-0 fixed inset-0">
    {/* Montamos la aplicación React asegurándonos que se ejecute del lado del cliente por la dependencia de Leaflet con Window */}
    <MaleconApp client:only="react" />
  </main>
</Layout>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Comportamiento touch de kiosco */
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
  }
</style>
