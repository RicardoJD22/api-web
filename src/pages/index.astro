---
import BentoArea from '../components/BentoArea.astro';
import FechaHora from '../components/FechaHora.astro';
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
---




<Layout title="Malecon La Paz BCS." showBack={false}>
	<SplashScreen autoSeconds={6} />
	<div class="mx-auto flex flex-col min-h-screen">
		<header class="py-1 px-4">
			<img class="mx-auto h-24 object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.08)]" src="/logos_header.png" alt="">
		</header>
		<BentoArea/> 
		<FechaHora />
	
		<slot />
	</div>
</Layout>
