---
import SectionLayout from "../layouts/SectionLayout.astro";

const statues = [
  {
    title: "Ballena Jorobada",
    author: "Octavio González",
    year: "2007",
    description: "Escultura de bronce que muestra a una ballena jorobada emergiendo del mar, obra del escultor Octavio González e inaugurada en 2007. Rinde homenaje a las migraciones de ballenas jorobadas que visitan el Mar de Cortés cada temporada invernal, destacando la importancia ecológica y turística de estos cetáceos para La Paz y toda la región sudcaliforniana.",
    image: "ballena-jorobada.webp",
  },
  {
    title: "La Perla",
    author: "Octavio González",
    year: "2007",
    description: "Obra de bronce de Octavio González que representa a una mujer saliendo de una enorme concha perlera, alusión directa al apodo de La Paz: \"La Perla del Mar de Cortés\". Celebra la época dorada en que la extracción de perlas fue la principal actividad económica y cultural de la ciudad, desde la época colonial hasta mediados del siglo XX, cuando La Paz era famosa a nivel mundial por la calidad de sus perlas.",
    image: "la-perla.webp",
  },
  {
    title: "El Ancla",
    author: "Marina Mexicana (donación)",
    year: "s/f",
    description: "Un ancla original de grandes dimensiones donada por la Armada de México y colocada como escultura urbana en el malecón. Es un homenaje permanente a los navegantes, pescadores y marineros que han dado vida al puerto de La Paz desde su fundación, recordando el carácter portuario e histórico que define a la ciudad hasta nuestros días.",
    image: "el-ancla.webp",
  },
  {
    title: "Paraiso del Mar",
    author: "Octavio González",
    year: "2000s",
    description: "Escultura de bronce de Octavio González que despliega una escena submarina con peces, caracoles, caballitos de mar y figuras onduladas que evocan el movimiento de las olas del Mar de Cortés. Donada por el desarrollo inmobiliario homónimo, fue instalada cerca del cruce con la calle 5 de Mayo como símbolo de bienvenida y como celebración de la biodiversidad marina que rodea la península de Baja California.",
    image: "paraiso-del-mar.webp",
  },
  {
    title: "El Viejo y el Mar",
    author: "Octavio González",
    year: "2006",
    description: "Inaugurada en marzo de 2006 por el escultor Octavio González, esta monumental pieza de bronce recrea el pasaje más icónico de la novela homónima de Ernest Hemingway: un pescador mayor, de cuerpo delgado y musculoso, sentado en una pequeña embarcación mientras enfrenta a un enorme pez marlín que surge del agua. Simboliza la perseverancia humana ante la naturaleza y la íntima relación de los paceños con el mar y la pesca.",
    image: "el-viejo-y-el-mar.webp",
  },
  {
    title: "La Paloma",
    author: "Carlos Espino",
    year: "2004",
    description: "Creada por el artista Carlos Espino e inaugurada en 2004 dentro del Proyecto de Remodelación del Malecón, esta escultura de bronce de gran formato representa a una paloma con líneas modernas y estilizadas elevada sobre una base para hacerla visible desde distintos puntos del paseo. Símbolo de paz, esperanza y libertad, su mensaje resuena con el propio nombre de la ciudad y la hospitalidad que caracteriza a sus habitantes.",
    image: "la-paloma.webp",
  }
];
---

<SectionLayout title="Historicos">
  <section>
    <aside>
      <h1 class="text-6xl font-black text-center my-6 uppercase">cronicas del malecon</h1>
    </aside>

    <article class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 auto-rows-[38rem] mx-auto my-auto gap-7 p-4">
      {
        statues.map((statue, idx) => (
          <div
            class="statue-card flex-col relative rounded-3xl z-20 flex items-start justify-end overflow-hidden cursor-pointer group shadow-2xl hover:scale-[1.03] transition-transform duration-300"
            tabindex="0"
            aria-label={`Ver detalles de ${statue.title}`}
            on:click={() => openModal(idx)}
            on:keydown={(e) => { if (e.key === 'Enter') openModal(idx); }}
          >
            <div class="absolute rounded-3xl z-10 bottom-0 top-0 h-full w-full mix-blend-multiply bg-gradient-to-t from-[#1fa39bcc] to-transparent"></div>
            <div
              class="absolute inset-0 bg-cover h-full w-full -z-10 rounded-3xl bg-blend-luminosity bg-center transition-background-image duration-500"
              style={`background-image: url('/statues/${statue.image}')`}
            ></div>
            <h2 class="text-[2.7rem] md:text-[3.5rem] font-black text-white z-20 p-8 drop-shadow-lg bg-black/30 rounded-2xl mb-4 ml-4 animate-fade-in">
              {statue.title}
            </h2>
          </div>
        ))
      }
    </article>

    {/* Modal grande para mostrar información de la estatua seleccionada */}
    <script type="text/javascript">
      const statues = [
        { title: "Ballena Jorobada", author: "Octavio González", year: "2007", description: "Escultura de bronce que muestra a una ballena jorobada emergiendo del mar, obra del escultor Octavio González e inaugurada en 2007. Rinde homenaje a las migraciones de ballenas jorobadas que visitan el Mar de Cortés cada temporada invernal, destacando la importancia ecológica y turística de estos cetáceos para La Paz y toda la región sudcaliforniana.", image: "ballena-jorobada.webp" },
        { title: "La Perla", author: "Octavio González", year: "2007", description: "Obra de bronce de Octavio González que representa a una mujer saliendo de una enorme concha perlera, alusión directa al apodo de La Paz: \"La Perla del Mar de Cortés\". Celebra la época dorada en que la extracción de perlas fue la principal actividad económica y cultural de la ciudad, desde la época colonial hasta mediados del siglo XX, cuando La Paz era famosa a nivel mundial por la calidad de sus perlas.", image: "la-perla.webp" },
        { title: "El Ancla", author: "Marina Mexicana (donación)", year: "s/f", description: "Un ancla original de grandes dimensiones donada por la Armada de México y colocada como escultura urbana en el malecón. Es un homenaje permanente a los navegantes, pescadores y marineros que han dado vida al puerto de La Paz desde su fundación, recordando el carácter portuario e histórico que define a la ciudad hasta nuestros días.", image: "el-ancla.webp" },
        { title: "Paraiso del Mar", author: "Octavio González", year: "2000s", description: "Escultura de bronce de Octavio González que despliega una escena submarina con peces, caracoles, caballitos de mar y figuras onduladas que evocan el movimiento de las olas del Mar de Cortés. Donada por el desarrollo inmobiliario homónimo, fue instalada cerca del cruce con la calle 5 de Mayo como símbolo de bienvenida y como celebración de la biodiversidad marina.", image: "paraiso-del-mar.webp" },
        { title: "El Viejo y el Mar", author: "Octavio González", year: "2006", description: "Inaugurada en marzo de 2006 por el escultor Octavio González, esta monumental pieza de bronce recrea el pasaje más icónico de la novela homónima de Ernest Hemingway: un pescador mayor en una pequeña embarcación enfrentando a un enorme pez marlín. Simboliza la perseverancia humana ante la naturaleza y la íntima relación de los paceños con el mar y la pesca.", image: "el-viejo-y-el-mar.webp" },
        { title: "La Paloma", author: "Carlos Espino", year: "2004", description: "Creada por Carlos Espino e inaugurada en 2004, esta escultura de bronce representa a una paloma con líneas modernas y estilizadas elevada sobre una base. Símbolo de paz, esperanza y libertad, su mensaje resuena con el propio nombre de la ciudad y la hospitalidad que caracteriza a sus habitantes.", image: "la-paloma.webp" }
      ];
      let modalOpen = false;
      let selectedIdx = null;
      function openModal(idx) {
        modalOpen = true;
        selectedIdx = idx;
        document.body.style.overflow = 'hidden';
        updateModal();
      }
      function closeModal() {
        modalOpen = false;
        selectedIdx = null;
        document.body.style.overflow = '';
        updateModal();
      }
      function updateModal() {
        const modal = document.getElementById('statue-modal');
        if (!modal) return;
        if (modalOpen && selectedIdx !== null) {
          modal.style.display = 'flex';
          modal.querySelector('.modal-title').textContent = statues[selectedIdx].title;
          modal.querySelector('.modal-img').src = `/statues/${statues[selectedIdx].image}`;
          modal.querySelector('.modal-img').alt = statues[selectedIdx].title;
          modal.querySelector('.modal-author').textContent = `${statues[selectedIdx].author} · ${statues[selectedIdx].year}`;
          modal.querySelector('.modal-desc').textContent = statues[selectedIdx].description;
        } else {
          modal.style.display = 'none';
        }
      }
      window.closeModal = closeModal;
      window.addEventListener('DOMContentLoaded', () => {
        // Asignar eventos a las tarjetas
        document.querySelectorAll('.statue-card').forEach((el, idx) => {
          el.addEventListener('click', () => openModal(idx));
          el.addEventListener('keydown', (e) => { if (e.key === 'Enter') openModal(idx); });
        });
        updateModal();
      });
    </script>
    <div id="statue-modal" style="display:none;" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-lg">
      <div class="relative w-full max-w-4xl mx-4 flex flex-col items-center justify-start bg-gray-900 rounded-2xl shadow-2xl p-6 md:p-10 overflow-y-auto animate-fade-in" style="max-height:92vh;">
        <button class="absolute top-4 right-4 text-gray-400 hover:text-blue-400 text-3xl font-bold z-10" onclick="closeModal()" aria-label="Cerrar">×</button>
        <img class="modal-img w-full h-72 md:h-96 object-cover rounded-xl mb-6 shadow-lg" src="" alt="" />
        <h2 class="modal-title text-3xl md:text-4xl font-extrabold text-white text-center mb-1 drop-shadow-lg"></h2>
        <p class="modal-author text-teal-400 text-sm font-semibold text-center mb-3 tracking-wide uppercase"></p>
        <p class="modal-desc text-slate-300 text-base text-center leading-relaxed mb-6 px-2"></p>
      </div>
    </div>
  </section>
</SectionLayout>

<style>
  h2 {
    font-family: "Komtits";
  }
  .statue-card:focus {
    outline: 3px solid #1fa39b;
    outline-offset: 2px;
  }
  .statue-card {
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .statue-card:hover {
    box-shadow: 0 8px 32px 0 #1fa39b55, 0 2px 8px 0 #0005;
  }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
</style>

<style is:global>
  @font-face {
    font-family: "Komtits";
    src: url("/fonts/KOMTITBR.ttf") format("truetype");
    font-style: normal;
    font-display: swap;
  }
</style>
