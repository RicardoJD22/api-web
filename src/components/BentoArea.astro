---
import BentoCard from "./BentoCard.astro";
import ImageCarousel from "./ImageCarousel.jsx";
import WeatherCard from "./WeatherCard.jsx";
import EventosCard from "./EventosCard.jsx";
import GuiaMaleconCard from "./GuiaMaleconCard.jsx";
import CoverflowGallery from "./CoverflowGallery.jsx";
import SocialCard from "./SocialCard.jsx";
---
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
</head>

<style>
.bento-glow {
  position: relative;
  z-index: 0;
}
.bento-glow::after {
  content: "";
  position: absolute;
  top: -4px; left: -4px; right: -4px; bottom: -4px;
  border-radius: 1.7rem;
  border: 4px solid;
  border-image: linear-gradient(120deg, #ffe066, #f87171, #60a5fa, #34d399, #f472b6, #ffe066) 1;
  pointer-events: none;
  z-index: 10;
  animation: border-glow 2.5s linear infinite;
}
@keyframes border-glow {
  0% { border-image-source: linear-gradient(120deg, #ffe066, #f87171, #60a5fa, #34d399, #f472b6, #ffe066); }
  100% { border-image-source: linear-gradient(480deg, #ffe066, #f87171, #60a5fa, #34d399, #f472b6, #ffe066); }
}

/* make sure images inside absolute figures fill and keep cover */
.bento-card-image img { width:100%; height:100%; object-fit:cover; }

/* small utility to prevent overflowing fixed-width elements */
.responsive-text { white-space: normal; word-break: break-word; }
</style>

<section class="min-h-screen w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 p-6 select-none auto-rows-fr relative z-10">
  <BentoCard
    href="survey"
    class="col-span-1 flex flex-col justify-end relative h-full"
    title=""
    description=""
    gradient="to-t from-slate-950/90 via-slate-900/50 to-transparent"
  >
    <figure slot="image" aria-label="Encuesta" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <img src="/pipa.jpg" alt="Encuesta" />
      <div class="absolute inset-0 bg-slate-900/40"></div>
    </figure>
    <div slot="content" class="relative z-10 flex flex-col items-center justify-between h-full w-full">
      <div class="w-full flex flex-row-reverse mb-auto px-4 pt-4">
         <span class="bg-cyan-500/90 backdrop-blur text-slate-950 font-bold px-5 py-2 rounded-full text-lg shadow-xl animate-pulse uppercase tracking-widest border border-cyan-300">Toca 👆</span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-black text-white drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)] text-center w-full px-4 mb-4 leading-tight tracking-wide">
        AYÚDANOS A <br/><span class="text-cyan-400">MEJORAR</span>
      </h2>
    </div>
  </BentoCard>

  <BentoCard
    href="reports"
    class="col-span-1 flex flex-col justify-end relative h-full group"
    title=""
    description=""
    gradient="to-tr from-amber-950/95 via-amber-900/80 to-transparent"
  >
    <figure slot="image" aria-label="Reporta un desperfecto" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <img src="/avisanos/1.jpg" alt="Desperfecto 1" class="group-active:scale-105 transition-transform duration-700 ease-out" />
      <div class="absolute inset-0 bg-slate-950/40 mix-blend-multiply"></div>
    </figure>
    
    <div slot="content" class="relative z-10 flex flex-col h-full w-full p-6">
      
      <div class="flex justify-between items-start w-full">
        <div class="bg-amber-500/20 border border-amber-400/30 backdrop-blur-md rounded-2xl p-3 flex shadow-lg items-center justify-center">
          <svg class="w-8 h-8 md:w-10 md:h-10 text-amber-300 opacity-90 drop-shadow-md" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
        </div>
         <span class="bg-amber-500 text-slate-900 font-extrabold px-5 py-2 rounded-full text-lg shadow-[0_0_20px_rgba(245,158,11,0.5)] uppercase tracking-widest border border-amber-300">Toca 👆</span>
      </div>

      <div class="mt-auto flex flex-col items-start text-left">
        <h1 class="text-5xl md:text-[4rem] font-black text-amber-50 drop-shadow-2xl mb-2 uppercase tracking-tighter leading-none">
          AVÍSANOS
        </h1>
        <h3 class="text-lg md:text-xl md:text-2xl font-bold text-amber-200/90 tracking-wide text-balance border-l-4 border-amber-500 pl-3">
          ¡Realiza un Reporte!
        </h3>
      </div>

    </div>
  </BentoCard>

  <!-- ECOS DEL MAR — tarjeta premium con oleaje animado y mosaico de esculturas -->
  <a
    href="historical"
    class="bento-glow col-span-1 flex flex-col justify-end relative h-full group rounded-[2rem] overflow-hidden active:scale-[0.98] transition-transform duration-200 cursor-pointer touch-manipulation"
    style="background: linear-gradient(170deg, #042f2e 0%, #0f172a 55%, #020617 100%);"
    aria-label="Ecos del Mar — Historia del Malecón de La Paz"
  >
    <!-- Fondo: foto del mar con parallax sutil -->
    <div class="absolute inset-0 overflow-hidden -z-10">
      <img
        src="/Galeria/whale.jpg"
        alt="Ballena"
        class="w-full h-full object-cover object-center scale-110 group-active:scale-125 transition-transform duration-700 ease-out opacity-30"
      />
      <!-- Gradiente multicapa: profundidad marina -->
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(2,6,23,0.3) 0%, rgba(4,47,46,0.5) 40%, rgba(2,6,23,0.97) 100%);"></div>
    </div>

    <!-- Partículas decorativas (burbujas) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
      <div class="bubble bubble-1"></div>
      <div class="bubble bubble-2"></div>
      <div class="bubble bubble-3"></div>
    </div>

    <!-- ── CONTENIDO ── -->
    <div class="relative z-10 flex flex-col h-full w-full p-5 gap-3">

      <!-- Header: badge + toca -->
      <div class="flex items-start justify-between w-full">
        <div class="flex flex-col gap-2">
          <!-- Badge categoría -->
          <div class="inline-flex items-center gap-2 bg-teal-500/15 border border-teal-400/30 backdrop-blur-md rounded-xl px-3 py-1.5">
            <svg class="w-4 h-4 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
            <span class="text-teal-300 text-xs font-bold tracking-widest uppercase">Historia & Cultura</span>
          </div>
        </div>
        <span class="bg-teal-500 text-slate-950 font-extrabold px-4 py-1.5 rounded-full text-sm shadow-[0_0_20px_rgba(20,184,166,0.5)] uppercase tracking-widest border border-teal-300 whitespace-nowrap">
          Toca 👆
        </span>
      </div>

      <!-- Strip de esculturas (preview) -->
      <div class="flex gap-2 mt-auto">
        {[
          { src: "/statues/ballena-jorobada.webp",  alt: "Ballena Jorobada",  fallback: "🐋" },
          { src: "/statues/la-perla.webp",           alt: "La Perla",          fallback: "🦪" },
          { src: "/statues/el-ancla.webp",           alt: "El Ancla",          fallback: "⚓" },
        ].map(s => (
          <div class="flex-1 aspect-square rounded-2xl overflow-hidden border border-teal-400/20 shadow-lg relative">
            <img
              src={s.src}
              alt={s.alt}
              class="w-full h-full object-cover opacity-80 group-active:opacity-100 transition-opacity"
              onerror={`this.onerror=null;this.parentElement.innerHTML='<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(20,184,166,0.12);font-size:1.8rem;">${s.fallback}</div>'`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-teal-950/80 to-transparent"></div>
          </div>
        ))}
        <!-- +3 más badge -->
        <div class="flex-1 aspect-square rounded-2xl border border-teal-400/20 flex items-center justify-center"
             style="background: rgba(20,184,166,0.08);">
          <div class="text-center">
            <span class="text-teal-300 font-black text-lg leading-none block">+3</span>
            <span class="text-teal-400/70 text-[10px] font-bold leading-none">más</span>
          </div>
        </div>
      </div>

      <!-- Título principal -->
      <div class="flex flex-col gap-1">
        <h2 class="text-4xl md:text-5xl font-black leading-none tracking-tighter"
            style="color: white; text-shadow: 0 0 40px rgba(20,184,166,0.6), 0 4px 12px rgba(0,0,0,0.8);">
          Ecos del Mar
        </h2>
        <p class="text-teal-200/80 text-sm font-semibold leading-snug border-l-2 border-teal-500 pl-2.5">
          Esculturas e historia viva en el Malecón de La Paz
        </p>
      </div>

      <!-- Wave + CTA -->
      <div class="relative">
        <!-- Ola SVG decorativa -->
        <svg viewBox="0 0 300 28" class="w-full mb-2 opacity-30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 14 C50 0, 100 28, 150 14 S250 0, 300 14" stroke="#2dd4bf" stroke-width="2" fill="none" class="wave-path"/>
          <path d="M0 20 C50 6, 100 34, 150 20 S250 6, 300 20" stroke="#0d9488" stroke-width="1.5" fill="none" class="wave-path-2"/>
        </svg>

        <!-- CTA Pill animado -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl border border-teal-400/40 w-full justify-center"
             style="background: linear-gradient(135deg, rgba(20,184,166,0.2), rgba(13,148,136,0.1)); backdrop-filter: blur(8px);">
          <span class="text-teal-300 font-black text-sm tracking-widest uppercase">Descubre las Esculturas</span>
          <svg class="w-4 h-4 text-teal-400 group-active:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </div>
      </div>
    </div>
  </a>

  <GuiaMaleconCard client:only="react" class="col-span-1 h-full" />

  <BentoCard
    href="galery"
    class="col-span-1 flex flex-col justify-end relative h-full group"
    title=""
    description=""
    gradient="to-t from-indigo-950/90 via-indigo-900/60 to-transparent"
  >
    <figure slot="image" aria-label="Galería de imágenes" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <ImageCarousel
        client:only="react"
        images={[
          '/Galeria/AA.jpg',
          '/Galeria/sea2.jpg',
          '/Galeria/malecon2.jpg',
          '/Galeria/whale.jpg',
          '/Galeria/sun.jpg',
          '/Galeria/night.jpg'
        ]}
        interval={2500}
        alt="Galería slider"
      />
      <div class="absolute inset-0 bg-slate-950/30 mix-blend-multiply pointer-events-none"></div>
    </figure>

    <div slot="content" class="relative z-10 flex flex-col h-full w-full p-6 justify-between">
      
      <div class="w-full flex justify-end">
         <span class="bg-indigo-500/90 text-indigo-50 font-extrabold px-5 py-2 rounded-full text-lg shadow-[0_0_20px_rgba(99,102,241,0.5)] uppercase tracking-widest border border-indigo-300 animate-pulse">Toca 👆</span>
      </div>

      <div class="mt-auto flex flex-col items-start w-full">
        <h1 class="text-4xl md:text-[3.5rem] font-black text-indigo-100 drop-shadow-2xl mb-3 uppercase tracking-tighter leading-none">
          GALERÍA
        </h1>
        <div class="w-full bg-indigo-950/40 border border-indigo-500/30 backdrop-blur-md rounded-xl p-3 border-l-4 overflow-hidden">
         <div class="marquee whitespace-nowrap text-indigo-100 text-sm sm:text-base font-bold drop-shadow tracking-widest uppercase text-center">
            <span>
               EXPLORA EL MALECÓN &nbsp;•&nbsp; CADA FOTO UNA EMOCIÓN &nbsp;•&nbsp; EXPLORA EL MALECÓN
            </span>
          </div>
        </div>
      </div>

    </div>
  </BentoCard>

  <div class="bento-glow col-span-1 flex flex-col justify-end items-center shadow-2xl rounded-3xl overflow-hidden bg-gradient-to-br from-gray-800 to-gray-900 relative h-full">
    <div class="w-full h-full flex flex-col items-center justify-end relative">
      <ImageCarousel
        client:only="react"
        images={["/bcs_logo.png", "/api_logo.png", "/m-lapaz.png"]}
        interval={2500}
        alt="Logo institucional"
        slogans={["H. XVIII AYUNTAMIENTO DEL MUNICIPIO DE LA PAZ B.C.S. 2024-2027", "¡Disfruta y cuida el malecón!", "COMPROMETIDOS CON LA COMUNIDAD"]}
      />
    </div>
  </div>

  <div class="bento-glow col-span-1 flex flex-col justify-center items-center shadow-2xl rounded-3xl overflow-hidden bg-gradient-to-br from-gray-800/60 to-blue-400/60 relative h-full">
    <WeatherCard client:only="react" />
  </div>

  <div class="bento-glow col-span-1 flex flex-col justify-center items-center shadow-2xl rounded-3xl overflow-hidden relative h-full" style="background: linear-gradient(160deg, #020617 0%, #0a1628 100%);">
    <EventosCard client:only="react" />
  </div>

  <div class="bento-glow col-span-1 flex flex-col justify-center items-center shadow-2xl rounded-3xl overflow-hidden relative h-full z-0" style="background: linear-gradient(145deg, #020617 0%, #0c1a2e 60%, #0a0f1e 100%)">
    <SocialCard client:only="react" siteOrigin={Astro.url.origin} />
  </div>
</section>