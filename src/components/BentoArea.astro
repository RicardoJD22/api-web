---
import BentoCard from "./BentoCard.astro";
import ImageCarousel from "./ImageCarousel.jsx";
import WeatherCard from "./WeatherCard.jsx";
import EventosCard from "./EventosCard.jsx";
import GuiaMaleconCard from "./GuiaMaleconCard.jsx";
import CoverflowGallery from "./CoverflowGallery.jsx";
---
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
</head>

<style>
.bento-glow {
  position: relative;
  z-index: 0;
}
.bento-glow::after {
  content: "";
  position: absolute;
  top: -4px; left: -4px; right: -4px; bottom: -4px;
  border-radius: 1.7rem;
  border: 4px solid;
  border-image: linear-gradient(120deg, #ffe066, #f87171, #60a5fa, #34d399, #f472b6, #ffe066) 1;
  pointer-events: none;
  z-index: 10;
  animation: border-glow 2.5s linear infinite;
}
@keyframes border-glow {
  0% { border-image-source: linear-gradient(120deg, #ffe066, #f87171, #60a5fa, #34d399, #f472b6, #ffe066); }
  100% { border-image-source: linear-gradient(480deg, #ffe066, #f87171, #60a5fa, #34d399, #f472b6, #ffe066); }
}

/* make sure images inside absolute figures fill and keep cover */
.bento-card-image img { width:100%; height:100%; object-fit:cover; }

/* small utility to prevent overflowing fixed-width elements */
.responsive-text { white-space: normal; word-break: break-word; }
</style>

<section class="min-h-screen w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 p-6 select-none auto-rows-fr relative z-10">
  <BentoCard
    href="survey"
    class="col-span-1 flex flex-col justify-end relative h-full"
    title=""
    description=""
    gradient="to-t from-slate-950/90 via-slate-900/50 to-transparent"
  >
    <figure slot="image" aria-label="Encuesta" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <img src="/pipa.jpg" alt="Encuesta" />
      <div class="absolute inset-0 bg-slate-900/40"></div>
    </figure>
    <div slot="content" class="relative z-10 flex flex-col items-center justify-between h-full w-full">
      <div class="w-full flex flex-row-reverse mb-auto px-4 pt-4">
         <span class="bg-cyan-500/90 backdrop-blur text-slate-950 font-bold px-5 py-2 rounded-full text-lg shadow-xl animate-pulse uppercase tracking-widest border border-cyan-300">Toca 👆</span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-black text-white drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)] text-center w-full px-4 mb-4 leading-tight tracking-wide">
        AYÚDANOS A <br/><span class="text-cyan-400">MEJORAR</span>
      </h2>
    </div>
  </BentoCard>

  <BentoCard
    href="reports"
    class="col-span-1 flex flex-col justify-end relative h-full group"
    title=""
    description=""
    gradient="to-tr from-amber-950/95 via-amber-900/80 to-transparent"
  >
    <figure slot="image" aria-label="Reporta un desperfecto" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <img src="/avisanos/1.jpg" alt="Desperfecto 1" class="group-active:scale-105 transition-transform duration-700 ease-out" />
      <div class="absolute inset-0 bg-slate-950/40 mix-blend-multiply"></div>
    </figure>
    
    <div slot="content" class="relative z-10 flex flex-col h-full w-full p-6">
      
      <div class="flex justify-between items-start w-full">
        <div class="bg-amber-500/20 border border-amber-400/30 backdrop-blur-md rounded-2xl p-3 flex shadow-lg items-center justify-center">
          <svg class="w-8 h-8 md:w-10 md:h-10 text-amber-300 opacity-90 drop-shadow-md" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
        </div>
         <span class="bg-amber-500 text-slate-900 font-extrabold px-5 py-2 rounded-full text-lg shadow-[0_0_20px_rgba(245,158,11,0.5)] uppercase tracking-widest border border-amber-300">Toca 👆</span>
      </div>

      <div class="mt-auto flex flex-col items-start text-left">
        <h1 class="text-5xl md:text-[4rem] font-black text-amber-50 drop-shadow-2xl mb-2 uppercase tracking-tighter leading-none">
          AVÍSANOS
        </h1>
        <h3 class="text-lg md:text-xl md:text-2xl font-bold text-amber-200/90 tracking-wide text-balance border-l-4 border-amber-500 pl-3">
          ¡Realiza un Reporte!
        </h3>
      </div>

    </div>
  </BentoCard>

  <BentoCard
    href="historical"
    class="col-span-1 flex flex-col justify-end relative h-full group"
    title=""
    description=""
    gradient="to-tr from-teal-950/95 via-teal-900/80 to-transparent"
  >
    <figure slot="image" aria-label="Historia del Malecón" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <!-- Usando la foto de la galería como fondo para evitar un espacio vacío o color muerto -->
      <img src="/Galeria/whale.jpg" alt="Whale" class="group-active:scale-105 transition-transform duration-700 ease-out object-cover w-full h-full" />
      <div class="absolute inset-0 bg-slate-950/50 mix-blend-multiply"></div>
    </figure>
    
    <div slot="content" class="relative z-10 flex flex-col h-full w-full p-6">
      
      <div class="flex justify-between items-start w-full">
        <div class="bg-teal-500/20 border border-teal-400/30 backdrop-blur-md rounded-2xl p-3 flex shadow-lg items-center justify-center">
          <svg class="w-8 h-8 md:w-10 md:h-10 text-teal-300 opacity-90 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
         <span class="bg-teal-500 text-slate-950 font-extrabold px-5 py-2 rounded-full text-lg shadow-[0_0_20px_rgba(20,184,166,0.5)] uppercase tracking-widest border border-teal-300">Toca 👆</span>
      </div>

      <div class="mt-auto flex flex-col items-start text-left">
        <h1 class="text-4xl md:text-[3.5rem] font-black text-teal-50 drop-shadow-2xl mb-2 uppercase tracking-tighter leading-none">
          Ecos del Mar
        </h1>
        <h3 class="text-lg md:text-xl font-bold text-teal-200/90 tracking-wide text-balance border-l-4 border-teal-500 pl-3">
          La Historia Cobra Vida en el Malecón de La Paz.
        </h3>
      </div>

    </div>
  </BentoCard>

  <GuiaMaleconCard client:load class="col-span-1 h-full" />

  <BentoCard
    href="galery"
    class="col-span-1 flex flex-col justify-end relative h-full group"
    title=""
    description=""
    gradient="to-t from-indigo-950/90 via-indigo-900/60 to-transparent"
  >
    <figure slot="image" aria-label="Galería de imágenes" class="absolute inset-0 bento-card-image -z-10 overflow-hidden">
      <ImageCarousel
        client:load
        images={[
          '/Galeria/AA.jpg',
          '/Galeria/sea2.jpg',
          '/Galeria/malecon2.jpg',
          '/Galeria/whale.jpg',
          '/Galeria/sun.jpg',
          '/Galeria/night.jpg'
        ]}
        interval={2500}
        alt="Galería slider"
      />
      <div class="absolute inset-0 bg-slate-950/30 mix-blend-multiply pointer-events-none"></div>
    </figure>

    <div slot="content" class="relative z-10 flex flex-col h-full w-full p-6 justify-between">
      
      <div class="w-full flex justify-end">
         <span class="bg-indigo-500/90 text-indigo-50 font-extrabold px-5 py-2 rounded-full text-lg shadow-[0_0_20px_rgba(99,102,241,0.5)] uppercase tracking-widest border border-indigo-300 animate-pulse">Toca 👆</span>
      </div>

      <div class="mt-auto flex flex-col items-start w-full">
        <h1 class="text-4xl md:text-[3.5rem] font-black text-indigo-100 drop-shadow-2xl mb-3 uppercase tracking-tighter leading-none">
          GALERÍA
        </h1>
        <div class="w-full bg-indigo-950/40 border border-indigo-500/30 backdrop-blur-md rounded-xl p-3 border-l-4 overflow-hidden">
         <div class="marquee whitespace-nowrap text-indigo-100 text-sm sm:text-base font-bold drop-shadow tracking-widest uppercase text-center">
            <span>
               EXPLORA EL MALECÓN &nbsp;•&nbsp; CADA FOTO UNA EMOCIÓN &nbsp;•&nbsp; EXPLORA EL MALECÓN
            </span>
          </div>
        </div>
      </div>

    </div>
  </BentoCard>

  <div class="bento-glow col-span-1 flex flex-col justify-end items-center shadow-2xl rounded-3xl overflow-hidden bg-gradient-to-br from-gray-800 to-gray-900 relative h-full">
    <div class="w-full h-full flex flex-col items-center justify-end relative">
      <ImageCarousel
        client:load
        images={["/bcs_logo.png", "/api_logo.png", "/m-lapaz.png"]}
        interval={2500}
        alt="Logo institucional"
        slogans={["H. XVIII AYUNTAMIENTO DEL MUNICIPIO DE LA PAZ B.C.S. 2024-2027", "¡Disfruta y cuida el malecón!", "COMPROMETIDOS CON LA COMUNIDAD"]}
      />
    </div>
  </div>

  <div class="bento-glow col-span-1 flex flex-col justify-center items-center shadow-2xl rounded-3xl overflow-hidden bg-gradient-to-br from-gray-800/60 to-blue-400/60 relative h-full">
    <WeatherCard client:load />
  </div>

  <div class="bento-glow col-span-1 flex flex-col justify-center items-center shadow-8xl rounded-5xl overflow-hidden bg-gray-600 relative h-full">
    <EventosCard client:load />
  </div>

  <div class="bento-glow col-span-1 flex flex-col justify-center items-center shadow-2xl rounded-3xl overflow-hidden bg-gradient-to-br from-gray-700 to-gray-900 relative h-full z-0">
    <div class="flex flex-col items-center justify-center h-full w-full p-6">
      <h2 class="text-xl sm:text-2xl font-bold text-white text-center mb-2">Redes Sociales</h2>
      <div class="flex flex-row gap-6 mb-2">
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 transition" fill="currentColor" viewBox="0 0 24 24">
            <path fill="#1877F3" d="M12 2.04c-5.5 0-9.96 4.46-9.96 9.96 0 4.41 3.6 8.07 8.24 8.93v-6.32h-2.48v-2.61h2.48V9.41c0-2.45 1.49-3.8 3.77-3.8 1.09 0 2.23.2 2.23.2v2.45h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.61h-2.34v6.32c4.64-.86 8.24-4.52 8.24-8.93 0-5.5-4.46-9.96-9.96-9.96z"/>
          </svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 transition" fill="currentColor" viewBox="0 0 24 24">
            <defs>
              <radialGradient id="ig-gradient" cx="50%" cy="50%" r="80%" fx="50%" fy="50%">
                <stop offset="0%" stop-color="#fdf497"/>
                <stop offset="45%" stop-color="#fdf497"/>
                <stop offset="60%" stop-color="#fd5949"/>
                <stop offset="90%" stop-color="#d6249f"/>
                <stop offset="100%" stop-color="#285AEB"/>
              </radialGradient>
            </defs>
            <path fill="url(#ig-gradient)" d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5zm4.25 2.25a5.25 5.25 0 1 1-5.25 5.25a5.25 5.25 0 0 1 5.25-5.25zm0 1.5a3.75 3.75 0 1 0 3.75 3.75a3.75 3.75 0 0 0-3.75-3.75zm5.25 1.25a1 1 0 1 1-2 0a1 1 0 0 1 2 0z"/>
          </svg>
        </a>
      </div>
      <span class="text-white text-center">Síguenos en nuestras redes sociales.</span>
      <div class="flex flex-col items-center mt-2">
        <img src={`https://api.qrserver.com/v1/create-qr-code/?size=80x80&data=${encodeURIComponent(Astro.url.origin + '/sube-tu-foto')}`} alt="QR para subir foto" class="rounded-xl border-2 border-blue-400 shadow bg-white" width="80" height="80" loading="lazy" />
        <span class="text-xs text-center text-white bg-blue-700 px-2 py-1 rounded-lg shadow mt-1">Escanea para subir tu foto</span>
      </div>
    </div>
  </div>
</section>