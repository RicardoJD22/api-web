---
interface Props {
  idleSeconds?: number;   // segundos de inactividad antes del aviso
  countdownSeconds?: number; // segundos del countdown antes de redirigir
  homeUrl?: string;
}

const {
  idleSeconds = 60,
  countdownSeconds = 10,
  homeUrl = "/"
} = Astro.props;
---

<!-- Overlay de inactividad -->
<div
  id="idle-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Sesión en pausa por inactividad"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center pointer-events-none opacity-0 transition-opacity duration-700"
  style="background: radial-gradient(ellipse at 50% 110%, #0c4a6e 0%, #0a0f1e 55%, #020617 100%);"
>
  <!-- Olas decorativas SVG (bottom) -->
  <div class="absolute bottom-0 left-0 right-0 overflow-hidden pointer-events-none">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full idle-wave-1">
      <path d="M0 60 C240 0, 480 120, 720 60 S1200 0, 1440 60 L1440 120 L0 120 Z" fill="rgba(6,182,212,0.12)"/>
    </svg>
    <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full absolute bottom-0 idle-wave-2">
      <path d="M0 50 C360 10, 720 90, 1080 50 S1440 10, 1440 50 L1440 100 L0 100 Z" fill="rgba(14,165,233,0.10)"/>
    </svg>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full absolute bottom-0 idle-wave-3">
      <path d="M0 40 C180 5, 360 75, 540 40 S900 5, 1080 40 S1260 75, 1440 40 L1440 80 L0 80 Z" fill="rgba(34,211,238,0.08)"/>
    </svg>
  </div>

  <!-- Burbujas flotantes -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    {Array.from({ length: 10 }).map((_, i) => (
      <div
        class="idle-bubble absolute rounded-full"
        style={`
          width: ${8 + (i * 7) % 24}px;
          height: ${8 + (i * 7) % 24}px;
          left: ${(i * 97 + 13) % 100}%;
          bottom: ${(i * 43 + 5) % 35}%;
          background: rgba(34,211,238,${0.08 + (i % 4) * 0.04});
          border: 1px solid rgba(34,211,238,0.2);
          animation-delay: ${(i * 0.8).toFixed(1)}s;
          animation-duration: ${5 + (i * 1.3) % 6}s;
        `}
      />
    ))}
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 flex flex-col items-center justify-center text-center px-8 gap-8">

    <!-- Ícono ola + pez -->
    <div class="text-7xl md:text-8xl select-none" aria-hidden="true">🌊</div>

    <!-- Mensaje -->
    <div class="flex flex-col items-center gap-3">
      <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight leading-none"
          style="text-shadow: 0 0 40px rgba(34,211,238,0.5);">
        ¿Sigues ahí?
      </h2>
      <p class="text-xl md:text-2xl text-cyan-200/80 font-medium max-w-md leading-snug">
        Toca la pantalla para continuar<br/>o regresaremos al inicio en
      </p>
    </div>

    <!-- Countdown circular -->
    <div class="relative w-36 h-36 md:w-44 md:h-44 flex items-center justify-center" aria-live="polite" aria-atomic="true">
      <!-- SVG ring -->
      <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
        <!-- Track -->
        <circle cx="50" cy="50" r="42" stroke="rgba(34,211,238,0.15)" stroke-width="6" fill="none"/>
        <!-- Progress -->
        <circle
          id="idle-ring"
          cx="50" cy="50" r="42"
          stroke="url(#cyanGrad)"
          stroke-width="6"
          fill="none"
          stroke-linecap="round"
          stroke-dasharray="263.9"
          stroke-dashoffset="0"
          style="transition: stroke-dashoffset 1s linear;"
        />
        <defs>
          <linearGradient id="cyanGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#22d3ee"/>
            <stop offset="100%" stop-color="#0891b2"/>
          </linearGradient>
        </defs>
      </svg>
      <!-- Número -->
      <span id="idle-count" class="text-6xl md:text-7xl font-black text-white tabular-nums"
            style="text-shadow: 0 0 24px rgba(34,211,238,0.7);">
        10
      </span>
    </div>

    <!-- CTA tap -->
    <div class="mt-2 flex items-center gap-3 px-8 py-4 rounded-2xl border border-cyan-400/30 bg-cyan-400/10 backdrop-blur-md animate-pulse">
      <span class="text-3xl" aria-hidden="true">👆</span>
      <span class="text-lg md:text-xl font-bold text-cyan-100 tracking-wide uppercase">Toca para continuar</span>
    </div>
  </div>
</div>

<style>
  /* Olas animadas */
  @keyframes wave-move {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .idle-wave-1 { animation: wave-move 8s linear infinite; width: 200%; }
  .idle-wave-2 { animation: wave-move 12s linear infinite reverse; width: 200%; }
  .idle-wave-3 { animation: wave-move 6s linear infinite; width: 200%; }

  /* Burbujas flotantes */
  @keyframes bubble-rise {
    0%   { transform: translateY(0) scale(1); opacity: 0.6; }
    80%  { opacity: 0.4; }
    100% { transform: translateY(-60vh) scale(1.2); opacity: 0; }
  }
  .idle-bubble { animation: bubble-rise linear infinite; }

  /* Estado visible del overlay */
  #idle-overlay.idle-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script is:inline define:vars={{ idleSeconds, countdownSeconds, homeUrl }}>
  (() => {
    const overlay  = document.getElementById('idle-overlay');
    const countEl  = document.getElementById('idle-count');
    const ring     = document.getElementById('idle-ring');

    if (!overlay || !countEl || !ring) return;

    const CIRCUMFERENCE = 263.9;
    let idleTimer    = null;
    let cdTimer      = null;
    let cdRemaining  = countdownSeconds;
    let overlayShown = false;

    // — mostrar overlay —
    function showOverlay() {
      overlayShown = true;
      cdRemaining  = countdownSeconds;
      countEl.textContent = cdRemaining;
      ring.style.strokeDashoffset = '0';
      overlay.classList.add('idle-visible');
      overlay.removeAttribute('aria-hidden');

      cdTimer = setInterval(() => {
        cdRemaining -= 1;
        countEl.textContent = cdRemaining;

        const progress = 1 - cdRemaining / countdownSeconds;
        ring.style.strokeDashoffset = String(CIRCUMFERENCE * progress);

        if (cdRemaining <= 0) {
          clearInterval(cdTimer);
          window.location.href = homeUrl;
        }
      }, 1000);
    }

    // — ocultar overlay —
    function hideOverlay() {
      overlayShown = false;
      clearInterval(cdTimer);
      overlay.classList.remove('idle-visible');
      overlay.setAttribute('aria-hidden', 'true');
      resetIdleTimer();
    }

    // — reiniciar temporizador de inactividad —
    function resetIdleTimer() {
      clearTimeout(idleTimer);
      idleTimer = setTimeout(showOverlay, idleSeconds * 1000);
    }

    // — eventos de actividad —
    const EVENTS = ['touchstart', 'touchmove', 'mousemove', 'mousedown', 'keydown', 'scroll', 'click'];

    function onActivity() {
      if (overlayShown) {
        hideOverlay();
      } else {
        resetIdleTimer();
      }
    }

    EVENTS.forEach(ev => document.addEventListener(ev, onActivity, { passive: true }));

    // — no activar en la página de inicio para evitar loop infinito —
    const isHome = window.location.pathname === homeUrl || window.location.pathname === homeUrl.replace(/\/$/, '') + '/';
    if (!isHome) {
      resetIdleTimer();
    }
  })();
</script>
