---
interface Props {
  href?: string;
  label?: string;
}
const { href = "/?skip=1", label = "Inicio" } = Astro.props;
---

<a
  href={href}
  aria-label={`Regresar a ${label}`}
  class="back-btn group fixed bottom-8 left-8 z-[9990] flex items-center gap-3
         px-6 py-4 rounded-2xl
         border border-cyan-500/40
         backdrop-blur-md
         shadow-[0_4px_24px_rgba(0,0,0,0.5)]
         active:scale-95 transition-transform duration-150
         touch-manipulation select-none"
  style="background: linear-gradient(135deg, rgba(8,47,73,0.92) 0%, rgba(12,74,110,0.88) 100%);"
>
  <!-- Ícono flecha -->
  <span class="back-arrow flex items-center justify-center w-10 h-10 rounded-xl
               bg-cyan-500/20 border border-cyan-400/30
               group-active:bg-cyan-500/40 transition-colors duration-150"
        aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="#67e8f9"
         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
         class="w-6 h-6 -translate-x-px">
      <path d="M19 12H5M5 12l7-7M5 12l7 7"/>
    </svg>
  </span>

  <!-- Texto -->
  <span class="flex flex-col leading-none">
    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-cyan-400/70">
      Regresar
    </span>
    <span class="text-lg font-black uppercase tracking-wide text-cyan-100">
      {label}
    </span>
  </span>

  <!-- Ola decorativa interior -->
  <span aria-hidden="true"
        class="absolute bottom-0 left-0 right-0 overflow-hidden rounded-b-2xl pointer-events-none h-6 opacity-20">
    <svg viewBox="0 0 200 24" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 12 C33 4, 66 20, 100 12 S167 4, 200 12 L200 24 L0 24 Z" fill="#22d3ee"/>
    </svg>
  </span>
</a>

<style>
  /* Pulso suave para llamar la atención en kiosko */
  .back-btn {
    animation: back-breathe 3s ease-in-out infinite;
  }
  @keyframes back-breathe {
    0%, 100% { box-shadow: 0 4px 24px rgba(0,0,0,0.5), 0 0 0 0 rgba(34,211,238,0); }
    50%       { box-shadow: 0 4px 32px rgba(0,0,0,0.6), 0 0 0 6px rgba(34,211,238,0.12); }
  }
  .back-btn:active { animation: none; }
</style>
