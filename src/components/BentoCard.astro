---
interface Props {
  title?: string;
  description?: string;
  class?: string;
  href: string;
  gradient: string;
}

const { title, description, href, gradient } = Astro.props;
---

<a
  href={href}
  class={`${Astro.props.class} relative rounded-[2rem] backdrop-blur-md border border-white/10 shadow-lg shadow-black/50 overflow-hidden group active:scale-[0.98] transition-transform duration-200 cursor-pointer touch-manipulation`}
>
  <div
    class={`absolute z-10 inset-0 bg-gradient-${gradient}`}
  >
  </div>

  <slot name="image" />

  <div
    class="relative select-none text-center flex flex-col items-center justify-center p-[0.95rem] z-20 h-full"
  >
    <h2 class="text-[6.6rem] font-black text-white uppercase">{title}</h2>
    {
      description && (
        <h3 class="text-5xl font-light text-slate-100 mb-4">{description}</h3>
      )
    }

    <slot name="content" />
  </div>
</a>

<style>
  h2, h3 {
    font-family: 'Outfit', sans-serif;
  }
</style>

<style is:global>
</style>
