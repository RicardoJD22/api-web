<script>
  function actualizarHora() {
    const ahora = new Date();
    const horas = ahora.getHours().toString().padStart(2, "0");
    const minutos = ahora.getMinutes().toString().padStart(2, "0");
    const elementoTiempo = document.querySelector(".hora-minimal");
    if (elementoTiempo) elementoTiempo.textContent = `${horas}:${minutos}`;
    setTimeout(actualizarHora, 1000);
  }
  function actualizarFecha() {
    const hoy = new Date();
    const opcionesFecha = {
      weekday: "short",
      year: "numeric",
      month: "short",
      day: "numeric",
    };
    const elementoFecha = document.querySelector(".fecha-minimal");
    if (elementoFecha)
      elementoFecha.textContent = hoy.toLocaleDateString("es-MX", opcionesFecha);
  }
  document.addEventListener("DOMContentLoaded", () => {
    actualizarHora();
    actualizarFecha();
  });
</script>

<div class="flex flex-col items-center justify-center select-none py-3">
  <span class="hora-minimal text-3xl md:text-5xl font-semibold text-black tracking-widest mb-1" style="font-family: 'Orbitron', sans-serif;"></span>
  <span class="fecha-minimal text-sm md:text-base font-semibold text-black tracking-wider uppercase" style="font-family: 'Orbitron', sans-serif;"></span>
</div>
