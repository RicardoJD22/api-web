<script>
  function actualizarHora() {
    const ahora = new Date();
    const horas = ahora.getHours().toString().padStart(2, "0");
    const minutos = ahora.getMinutes().toString().padStart(2, "0");
    const segundos = ahora.getSeconds().toString().padStart(2, "0");
    const elementoTiempo = document.querySelector(".hora-minimal");
    if (elementoTiempo) elementoTiempo.textContent = `${horas}:${minutos}:${segundos}`;
    setTimeout(actualizarHora, 1000);
  }
  function actualizarFecha() {
    const hoy = new Date();
    const opcionesFecha = {
      weekday: "short",
      year: "numeric",
      month: "short",
      day: "numeric",
    };
    const elementoFecha = document.querySelector(".fecha-minimal");
    if (elementoFecha)
      elementoFecha.textContent = hoy.toLocaleDateString("es-MX", opcionesFecha);
  }
  document.addEventListener("DOMContentLoaded", () => {
    actualizarHora();
    actualizarFecha();
  });
</script>

<div class="flex flex-col items-center justify-center select-none bg-slate-900/60 backdrop-blur-md rounded-3xl px-8 py-3 border border-slate-700/50 shadow-2xl">
  <span class="hora-minimal font-mono text-3xl md:text-5xl font-black text-slate-100 tracking-widest mb-1 shadow-sm drop-shadow-md"></span>
  <span class="fecha-minimal text-sm md:text-base font-bold text-indigo-300 tracking-wider uppercase"></span>
</div>
