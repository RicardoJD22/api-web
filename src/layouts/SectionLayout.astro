---
interface Props {
	title: string;
}
import FechaHora from '../components/FechaHora.astro';
import IdleReset from '../components/IdleReset.astro';
import BackButton from '../components/BackButton.astro';
import AccessibilityBar from '../components/AccessibilityBar.astro';
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Malecón de La Paz BCS" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — Malecón La Paz</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;700;800&family=Orbitron:wght@600&display=swap" rel="stylesheet">
		<style is:global>
			h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
			body { font-family: 'Outfit', sans-serif; }
		</style>
	</head>
		<body class="bg-slate-950 text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200">

		
		

		<header class="relative flex items-center mb-0 pt-2 w-full">
			<img class="absolute left-4 md:left-8 w-[140px] md:w-[180px] lg:w-[220px]" src="/bcs_logo.png" alt="Logo BCS" />
			<div class="flex-1 flex justify-center">
				<div class="scale-110 md:scale-125">
					<FechaHora color="text-white" />
				</div>
			</div>
			<img class="absolute right-4 md:right-8 w-[120px] md:w-[160px] lg:w-[200px]" src="/api_logo.png" alt="Logo API" />
		</header>


		<slot />
		<IdleReset idleSeconds={60} countdownSeconds={10} homeUrl="/" />
		<BackButton />
		<AccessibilityBar />
	</body>
</html>